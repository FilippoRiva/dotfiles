{
// Explorer
"explorer.compactFolders": false,

// Workbench
"workbench.iconTheme": "material-icon-theme",
"workbench.productIconTheme": "material-product-icons",
"workbench.colorTheme": "Wal",
"workbench.list.smoothScrolling": true,
"workbench.secondarySideBar.showLabels": false,
"workbench.panel.showLabels": false,
"workbench.editor.titleScrollbarVisibility": "hidden",
"workbench.editor.closeEmptyGroups": true,
"workbench.startupEditor": "none",

//Editor
"editor.fontFamily": "'GeistMono Nerd Font Propo', 'Droid Sans Mono', monospace",
"editor.fontSize": 13,
"editor.padding.bottom": 20,
"editor.padding.top": 20,
"editor.inlayHints.padding": true,
"editor.smoothScrolling": true,
"editor.cursorSmoothCaretAnimation": "on",
"editor.cursorBlinking": "expand",

"terminal.integrated.smoothScrolling": true,
"terminal.integrated.cursorStyle": "line",

"breadcrumbs.enabled": false,

"window.titleBarStyle": "native",
"window.customTitleBarVisibility": "never",
"window.menuBarVisibility": "hidden",

// Vim
"vim.leader": "<space>",
"vim.easymotion": true,
"vim.incsearch": true,
"vim.useCtrlKeys": true,
"vim.hlsearch": false,
"vim.ignorecase": true,
"vim.smartcase": true,
"vim.useSystemClipboard": true,
"vim.sneak": true,
"vim.surround": true,
"vim.replaceWithRegister": true,
"vim.camelCaseMotion.enable": true,
"vim.argumentObjectSeparators": [",", ";"],
"vim.argumentObjectOpeningDelimiters": ["(", "["],
"vim.argumentObjectClosingDelimiters": [")", "]"],
"vim.insertModeKeyBindings": [
    {
        "before": ["j", "j"],
        "after": ["<Esc>"]
    },
    {
        "before": ["j", "k"],
        "after": ["<Esc>"]
    },
    {
        "before": ["<C-s>"],
        "commands": [":w"]
    },
    {
        "before": ["<A-j>"],
        "commands": ["editor.action.moveLinesDownAction"]
    },
    {
        "before": ["<A-k>"],
        "commands": ["editor.action.moveLinesUpAction"]
    }
],

"vim.normalModeKeyBindings": [
    {
        "before": ["<tab>"],
        "commands": ["workbench.action.nextEditor"]
    },
    {
        "before": ["<S-tab>"],
        "commands": ["workbench.action.previousEditor"]
    },
    {
        "before": ["g", "d"],
        "commands": ["editor.action.revealDefinition"]
    },
    {
        "before": ["g", "r"],
        "commands": ["editor.action.goToReferences"]
    },
    {
        "before": ["g", "i"],
        "commands": ["editor.action.goToImplementation"]
    },
    {
        "before": ["K"],
        "commands": ["editor.action.showHover"]
    },
    {
        "before": ["[", "d"],
        "commands": ["editor.action.marker.prev"]
    },
    {
        "before": ["]", "d"],
        "commands": ["editor.action.marker.next"]
    },
    {
        "before": ["g", "h"],
        "after": ["^"]
    },
    {
        "before": ["g", "l"],
        "after": ["$"]
    }
],
"vim.visualModeKeyBindings": [
    {
        "before": [">"],
        "after": [">", "g", "v"]
    },
    {
        "before": ["<"],
        "after": ["<", "g", "v"]
    },
    {
        "before": ["g", "c", "c"],
        "commands": ["editor.action.commentLine", "extension.vim_escape"]
    },
    {
        "before": ["g", "c"],
        "commands": ["editor.action.commentLine"]
    },
    {
        "before": ["g", "h"],
        "after": ["^"]
    },
    {
        "before": ["g", "l"],
        "after": ["$"]
    }
],
"vim.normalModeKeyBindingsNonRecursive": [
    {
        "before": ["<C-n>"],
        "commands": [":nohl"]
    },
    {
        "before": ["u"],
        "after": ["u"]
    },
    {
        "before": ["<C-r>"],
        "after": ["<C-r>"]
    }
],
"vim.handleKeys": {
    "<C-a>": false,
    "<C-f>": false,
    "<C-w>": false,
    "<C-c>": false,
    "<C-v>": false,
    "<C-x>": false,
    "<C-z>": false,
    "<C-y>": false
},
"extensions.experimental.affinity": {
    "vscodevim.vim": 1
}

// Latex Workshop
"latex-workshop.latex.autoClean.run": "onBuilt",
"latex-workshop.latex.outDir": "%DIR%/out",
"latex-workshop.latex.auxDir": "%DIR%/out",
"latex-workshop.latex.clean.subfolder.enabled": true,
"latex-workshop.latex.clean.method": "glob",
"latex-workshop.latex.clean.fileTypes": [
  // defaults 
  "*.aux",
  "*.bbl",
  "*.blg",
  "*.idx",
  "*.ind",
  "*.lof",
  "*.lot",
  "*.out",
  "*.toc",
  "*.acn",
  "*.acr",
  "*.alg",
  "*.glg",
  "*.glo",
  "*.gls",
  "*.fls",
  "*.log",
  "*.fdb_latexmk",
  "*.snm",
  "*.nav",
  "*.vrb",
  // minted
  "thesis.listing",
  "_minted/*",
  // misterious additional src folder
  "src/*"
],

// QT
"workbench.editorAssociations": {
    "{git,gitlens,chat-editing-snapshot-text-model,copilot,git-graph,git-graph-3}:/**/*.qrc": "default",
    "*.qrc": "qt-core.qrcEditor"
},
"qt-core.additionalQtPaths": [
    {
        "name": "Qt-5.15.19-linux-g++-x86_64_from_PATH",
        "path": "/usr/bin/qmake"
    }
],
"qt-qml.qmlls.useQmlImportPathEnvVar": true,
"qt-qml.qmlls.customExePath": "/usr/bin/qmlls6",
"qt-qml.doNotAskForQmllsDownload": true,
"qt-core.showWelcomePageOnActivation": false,

// Git
"git.autofetch": true,
}
